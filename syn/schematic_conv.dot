digraph "cnn_conv_engine" {
label="cnn_conv_engine";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="bias_in", color="black", fontcolor="black"];
n2 [ shape=octagon, label="busy", color="black", fontcolor="black"];
n3 [ shape=octagon, label="clk", color="black", fontcolor="black"];
n4 [ shape=octagon, label="conv_out_relu", color="black", fontcolor="black"];
n5 [ shape=octagon, label="done", color="black", fontcolor="black"];
n6 [ shape=diamond, label="mac_acc", color="black", fontcolor="black"];
n7 [ shape=diamond, label="mac_busy", color="black", fontcolor="black"];
n8 [ shape=diamond, label="mac_done", color="black", fontcolor="black"];
n9 [ shape=octagon, label="pixel_in", color="black", fontcolor="black"];
n10 [ shape=octagon, label="pixel_last", color="black", fontcolor="black"];
n11 [ shape=octagon, label="pixel_valid", color="black", fontcolor="black"];
n12 [ shape=octagon, label="raw_acc", color="black", fontcolor="black"];
n13 [ shape=diamond, label="relu_val", color="black", fontcolor="black"];
n14 [ shape=octagon, label="rst_n", color="black", fontcolor="black"];
n15 [ shape=octagon, label="start", color="black", fontcolor="black"];
n16 [ shape=octagon, label="weight_in", color="black", fontcolor="black"];
c21 [ shape=record, label="{{<p1> bias_in|<p3> clk|<p17> data_in|<p18> in_valid|<p19> last|<p14> rst_n|<p15> start|<p16> weight_in}|u_mac\ncnn_mac|{<p20> accumulator|<p2> busy|<p5> done}}",  ];
c24 [ shape=record, label="{{<p22> value_in}|u_relu\ncnn_relu_sat_u8|{<p23> value_out}}",  ];
x0 [shape=point, ];
x1 [shape=point, ];
x2 [shape=point, ];
x3 [shape=point, ];
n1:e -> c21:p1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n10:e -> c21:p19:w [color="black", fontcolor="black", label=""];
n11:e -> c21:p18:w [color="black", fontcolor="black", label=""];
x3:e -> n12:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c24:p23:e -> n13:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n13:e -> x1:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n14:e -> c21:p14:w [color="black", fontcolor="black", label=""];
n15:e -> c21:p15:w [color="black", fontcolor="black", label=""];
n16:e -> c21:p16:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x0:e -> n2:w [color="black", fontcolor="black", label=""];
n3:e -> c21:p3:w [color="black", fontcolor="black", label=""];
x1:e -> n4:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
x2:e -> n5:w [color="black", fontcolor="black", label=""];
c21:p20:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c24:p22:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> x3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c21:p2:e -> n7:w [color="black", fontcolor="black", label=""];
n7:e -> x0:w [color="black", fontcolor="black", label=""];
c21:p5:e -> n8:w [color="black", fontcolor="black", label=""];
n8:e -> x2:w [color="black", fontcolor="black", label=""];
n9:e -> c21:p17:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
